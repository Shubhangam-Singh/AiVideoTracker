# Reel Studio server config
PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string

# Initial seed passwords (used only on first boot; change in Settings afterward)
SEED_PW_SHUB=changeme-shub
SEED_PW_SAN=changeme-san

# AI assistant (optional — needed for @claude mentions in chat)
ANTHROPIC_API_KEY=

# YouTube Analytics — create at console.cloud.google.com
# OAuth 2.0 Client ID for a Web Application
# Authorized redirect URI: https://yourdomain.com/api/analytics/callback/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram / Meta — create at developers.facebook.com
# Instagram Basic Display or Graph API app
# Authorized redirect URI: https://yourdomain.com/api/analytics/callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Base URL for OAuth redirect URIs (no trailing slash)
# In dev: http://localhost:3001 — in prod: https://yourdomain.com
APP_BASE_URL=http://localhost:3001

# Set to "false" to disable secure cookies when testing over plain HTTP in prod
COOKIE_SECURE=
